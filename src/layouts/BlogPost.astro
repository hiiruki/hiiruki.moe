---
import { type CollectionEntry, render } from "astro:content";

import Masthead from "@/components/blog/Masthead.astro";
import PostNav from "@/components/blog/PostNav.astro";
import RelatedPosts from "@/components/blog/RelatedPosts.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import { getAdjacentPosts, getRelatedPosts } from "@/data/post";
import { siteConfig } from "@/site.config";
import { getGitUpdatedDate } from "@/utils/git-updated-date";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate } = post.data;
const gitUpdatedDate = getGitUpdatedDate(post.id);
const effectiveUpdatedDate = updatedDate ?? gitUpdatedDate;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = effectiveUpdatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;
const { newer, older } = await getAdjacentPosts(post.id);
const relatedPosts = await getRelatedPosts(post);

const canonicalURL = new URL(`/posts/${post.id}/`, siteConfig.url).href;
const ogImageURL = new URL(socialImage, siteConfig.url).href;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	image: ogImageURL,
	datePublished: publishDate.toISOString(),
	dateModified: articleDate,
	author: {
		"@type": "Person",
		name: siteConfig.author,
		url: siteConfig.url,
	},
	publisher: {
		"@type": "Person",
		name: siteConfig.author,
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": canonicalURL,
	},
	keywords: post.data.tags.join(", "),
};
---

<BaseLayout
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
	}}
	wideLayout={!!headings.length}
>
	<div
		id="reading-progress"
		class="fixed inset-x-0 top-0 z-100 h-1 origin-left scale-x-0 bg-accent"
		aria-hidden="true"
	></div>
	<article class="grow wrap-break-word" data-pagefind-body>
		<div id="blog-hero" class="mb-8"><Masthead content={post} readingTime={readingTime} updatedDate={effectiveUpdatedDate} /></div>
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
			{!!headings.length && <TOC headings={headings} />}
			<div
				class="prose prose-sm prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-gray-600 prose-headings:hover:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none max-w-none min-w-0"
			>
				<slot />
				<WebMentions />
			</div>
		</div>
	</article>
	<PostNav newer={newer} older={older} />
	<RelatedPosts posts={relatedPosts} />
	<button
		class="fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full bg-zinc-200 opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
		data-show="false"
		id="to-top-btn"
		aria-label="Back to top"
	>
		<span class="sr-only">Back to top</span>
		<svg
			aria-hidden="true"
			class="absolute inset-0 h-full w-full -rotate-90"
			fill="none"
			focusable="false"
			viewBox="0 0 48 48"
			xmlns="http://www.w3.org/2000/svg"
		>
			<circle
				id="to-top-progress"
				cx="24"
				cy="24"
				r="22"
				stroke="currentColor"
				stroke-width="2.5"
				stroke-linecap="round"
				class="text-accent"
				pathLength="1"
				stroke-dasharray="1"
				stroke-dashoffset="1"
			></circle>
		</svg>
		<svg
			aria-hidden="true"
			class="relative h-4 w-4"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="1.75"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M12 20V4M5 11l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
	<dialog
		id="image-zoom"
		class="h-full max-h-none w-full max-w-none overflow-auto bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm"
	>
		<div id="image-zoom-wrap" class="flex min-h-full min-w-full items-center justify-center p-4">
			<img
				id="image-zoom-img"
				alt=""
				data-zoom="0"
				class="max-h-[95vh] max-w-[95vw] origin-center object-contain transition-transform duration-200 data-[zoom=0]:cursor-zoom-in data-[zoom=1]:scale-150 data-[zoom=1]:cursor-zoom-in data-[zoom=2]:scale-250 data-[zoom=2]:cursor-zoom-out"
			/>
		</div>
	</dialog>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			// only show the scroll to top button when the heading is out of view
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);

	// Reading progress bar + scroll-to-top ring
	const progressBar = document.getElementById("reading-progress");
	const progressRing = document.getElementById("to-top-progress") as SVGCircleElement | null;
	if (progressBar || progressRing) {
		const updateProgress = () => {
			const scrollTop = document.documentElement.scrollTop;
			const scrollHeight =
				document.documentElement.scrollHeight - document.documentElement.clientHeight;
			const progress = scrollHeight > 0 ? scrollTop / scrollHeight : 0;
			if (progressBar) progressBar.style.transform = `scaleX(${progress})`;
			if (progressRing) progressRing.style.strokeDashoffset = `${1 - progress}`;
		};
		updateProgress();
		document.addEventListener("scroll", updateProgress, { passive: true });
	}

	// Image zoom: 1st click opens fit-to-screen; click image toggles full-size; click outside closes
	const zoomDialog = document.getElementById("image-zoom") as HTMLDialogElement | null;
	const zoomImg = document.getElementById("image-zoom-img") as HTMLImageElement | null;
	const zoomWrap = document.getElementById("image-zoom-wrap") as HTMLDivElement | null;
	if (zoomDialog && zoomImg && zoomWrap) {
		document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
			img.style.cursor = "zoom-in";
			img.addEventListener("click", () => {
				zoomImg.src = img.currentSrc || img.src;
				zoomImg.alt = img.alt;
				zoomImg.dataset.zoom = "0";
				zoomDialog.showModal();
			});
		});
		zoomImg.addEventListener("pointerdown", (e) => e.stopPropagation());
		zoomImg.addEventListener("click", (e) => {
			e.stopPropagation();
			zoomImg.dataset.zoom = String((Number(zoomImg.dataset.zoom) + 1) % 3);
		});
		zoomDialog.addEventListener("pointerdown", (e) => {
			if (e.target !== zoomImg) zoomDialog.close();
		});
	}

	// Click a heading to copy its anchor link
	const headings = document.querySelectorAll<HTMLHeadingElement>(
		".prose :is(h2, h3, h4, h5, h6)[id]",
	);
	headings.forEach((heading) => {
		heading.style.cursor = "pointer";
		heading.title = "Click to copy link to this section";
		heading.addEventListener("click", () => {
			const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
			history.replaceState(null, "", `#${heading.id}`);
			navigator.clipboard?.writeText(url).then(() => {
				const original = heading.dataset.copyLabel;
				if (original === undefined) {
					heading.dataset.copyLabel = heading.title;
				}
				heading.title = "Link copied!";
				setTimeout(() => {
					heading.title = heading.dataset.copyLabel ?? "Click to copy link to this section";
				}, 1500);
			});
		});
	});
</script>
