---
const username = import.meta.env.LASTFM_USERNAME || "";
const apiKey = import.meta.env.LASTFM_API_KEY || "";
const enabled = !!(username && apiKey);
---

<div
	id="lastfm-card"
	class="group/lastfm relative mt-8 hidden w-max cursor-pointer items-center gap-4 outline-none"
	tabindex="0"
	data-enabled={enabled ? "true" : "false"}
>
	<img
		id="lastfm-art"
		src=""
		alt="Album Art"
		class="h-16 w-16 shrink-0 rounded-xl bg-black/10 object-cover shadow-sm dark:bg-white/10"
	/>
	<div class="flex flex-col justify-center gap-1.5">
		<div class="flex items-center gap-2">
			<div id="lastfm-status-dot" class="h-1.5 w-1.5 rounded-full bg-amber-500"></div>
			<span
				id="lastfm-status"
				class="font-mono text-[10px] font-bold tracking-widest text-amber-500 uppercase"
				>PAUSED</span
			>
		</div>
		<a
			id="lastfm-link"
			href="#"
			target="_blank"
			rel="noopener noreferrer"
			class="hover:text-accent max-w-[200px] truncate font-mono text-sm opacity-80 transition-colors hover:opacity-100 sm:max-w-[300px]"
		>
			<span id="lastfm-track" class="truncate">Track</span> - <span
				id="lastfm-artist"
				class="truncate">Artist</span
			>
		</a>
	</div>

	<div
		class="invisible absolute top-full left-0 z-50 mt-3 flex w-[280px] translate-y-2 cursor-default flex-col rounded-xl border border-[#313338] bg-[#111214] p-4 opacity-0 shadow-2xl transition-all delay-200 duration-300 group-hover/lastfm:visible group-hover/lastfm:translate-y-0 group-hover/lastfm:opacity-100 group-hover/lastfm:delay-0 before:absolute before:-top-3 before:left-0 before:h-3 before:w-full sm:right-auto sm:left-auto sm:w-[340px] dark:bg-[#111214]"
	>
		<h4
			id="hover-status-title"
			class="mb-3 text-[10px] font-bold tracking-widest text-[#B5BAC1] uppercase"
		>
			NOT PLAYING
		</h4>

		<div class="relative mb-3 flex items-center gap-3">
			<img
				id="hover-art"
				src=""
				class="h-14 w-14 shrink-0 rounded-md bg-[#2b2d31] object-cover shadow-md"
			/>
			<div class="flex min-w-0 flex-col justify-center">
				<span id="hover-track" class="truncate text-sm font-bold text-white">Track</span>
				<span id="hover-artist" class="mt-0.5 truncate text-xs text-[#B5BAC1]">Artist</span>
			</div>
		</div>

		<div class="mb-3 flex items-center rounded-lg border border-[#1e1f22] bg-[#2b2d31] p-3">
			<p id="hover-time" class="text-xs text-[#DBDEE1]">Last listened...</p>
		</div>

		<div class="mt-1 border-t border-[#313338] pt-3">
			<button
				id="open-history-btn"
				class="w-full text-left text-[10px] font-bold tracking-widest text-[#B5BAC1] uppercase transition-colors hover:text-white focus:outline-none"
			>
				CLICK TO OPEN LISTENING HISTORY
			</button>
		</div>

		<div
			id="history-dropdown"
			class="mt-3 hidden max-h-48 flex-col space-y-1 overflow-y-auto border-t border-[#313338] pt-3 pr-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
		>
			<div id="lastfm-recent-list" class="flex flex-col space-y-1">
				<span class="text-xs text-[#B5BAC1] italic">Loading history...</span>
			</div>
		</div>
	</div>
</div>

<div id="lastfm-skeleton" class="mt-8 flex animate-pulse items-center gap-4">
	<div class="h-16 w-16 shrink-0 rounded-xl bg-black/10 dark:bg-white/10"></div>
	<div class="flex w-full flex-col justify-center gap-2">
		<div class="flex items-center gap-2">
			<div class="h-1.5 w-1.5 rounded-full bg-black/10 dark:bg-white/10"></div>
			<div class="h-2 w-16 rounded bg-black/10 dark:bg-white/10"></div>
		</div>
		<div class="h-3 w-48 rounded bg-black/10 dark:bg-white/10"></div>
	</div>
</div>

<script is:inline>
	function formatTimeAgo(uts) {
		if (!uts) return "Unknown";
		var diffSec = Math.floor(Date.now() / 1000) - parseInt(uts);
		if (diffSec < 60) return "Just now";
		if (diffSec < 3600) return Math.floor(diffSec / 60) + "m ago";
		if (diffSec < 86400) return Math.floor(diffSec / 3600) + "h ago";
		return Math.floor(diffSec / 86400) + "d ago";
	}

	function getTrackImage(track, size) {
		if (!track || !track.image) return "";
		var match = track.image.find(function(img) { return img.size === size; });
		return (match && match["#text"]) || (track.image[track.image.length - 1] && track.image[track.image.length - 1]["#text"]) || "";
	}

	function buildHistoryItem(t) {
		var img = getTrackImage(t, "medium");
		var url = t.url || "#";
		var trackName = t.name || "Unknown";
		var artistName = (t.artist && t.artist["#text"]) || "Unknown";
		var timeString = formatTimeAgo(t.date && t.date.uts);

		var a = document.createElement("a");
		a.href = url;
		a.target = "_blank";
		a.rel = "noopener noreferrer";
		a.className = "flex items-center gap-3 hover:bg-[#2b2d31] p-2 -mx-2 rounded-lg transition-colors group/item cursor-pointer";

		var imgEl = document.createElement("img");
		imgEl.src = img;
		imgEl.alt = "Art";
		imgEl.className = "h-8 w-8 rounded shrink-0 object-cover shadow-sm bg-[#2b2d31]";
		a.appendChild(imgEl);

		var textCol = document.createElement("div");
		textCol.className = "flex flex-col min-w-0";

		var nameSpan = document.createElement("span");
		nameSpan.className = "text-xs font-semibold text-gray-200 truncate group-hover/item:text-white transition-colors";
		nameSpan.textContent = trackName;
		textCol.appendChild(nameSpan);

		var metaDiv = document.createElement("div");
		metaDiv.className = "flex items-center gap-2 text-[10px] text-[#B5BAC1] mt-0.5";

		var artistSpan = document.createElement("span");
		artistSpan.className = "truncate";
		artistSpan.textContent = artistName;
		metaDiv.appendChild(artistSpan);

		var bulletSpan = document.createElement("span");
		bulletSpan.className = "shrink-0 opacity-70";
		bulletSpan.textContent = "\u2022 " + timeString;
		metaDiv.appendChild(bulletSpan);

		textCol.appendChild(metaDiv);
		a.appendChild(textCol);

		return a;
	}

	async function fetchLastFm() {
		try {
			var skeleton = document.getElementById("lastfm-skeleton");
			var card = document.getElementById("lastfm-card");

			var enabled = card && card.dataset && card.dataset.enabled === "true";

			if (!enabled) {
				if (skeleton) skeleton.classList.add("hidden");
				return;
			}

			var res = await fetch("/api/lastfm").catch(function() { return null; });

			if (!res || !res.ok) {
				if (skeleton) skeleton.classList.add("hidden");
				return;
			}

			var data = await res.json();
			var tracks = data.recenttracks && data.recenttracks.track;

			if (skeleton && card && tracks && tracks.length > 0) {
				var trackData = tracks[0];
				var isPlaying = trackData["@attr"] && trackData["@attr"].nowplaying === "true";

				if (isPlaying) {
					trackData.cachedAt = Date.now();
					try { localStorage.setItem("lastfm-nowplaying", JSON.stringify(trackData)); } catch(e) {}
				} else {
					var cached = null;
					try { cached = localStorage.getItem("lastfm-nowplaying"); } catch(e) {}
					if (cached) {
						try {
							var cachedTrack = JSON.parse(cached);
							var lastScrobbleTime = parseInt((trackData.date && trackData.date.uts) || "0") * 1000;
							if (
								cachedTrack.cachedAt &&
								cachedTrack.cachedAt > lastScrobbleTime &&
								cachedTrack.name !== trackData.name
							) {
								trackData = cachedTrack;
							}
						} catch (e) {
							// Silently ignore corrupt cache
						}
					}
				}

				skeleton.classList.add("hidden");
				card.classList.remove("hidden");
				card.classList.add("flex");

				var image = getTrackImage(trackData, "extralarge");

				var art = document.getElementById("lastfm-art");
				var statusDot = document.getElementById("lastfm-status-dot");
				var statusText = document.getElementById("lastfm-status");
				var track = document.getElementById("lastfm-track");
				var artist = document.getElementById("lastfm-artist");
				var link = document.getElementById("lastfm-link");

				if (art) art.src = image;
				if (track) track.textContent = trackData.name;
				if (artist) artist.textContent = (trackData.artist && trackData.artist["#text"]) || "Unknown Info";

				if (link && trackData.url) {
					link.href = trackData.url;
				} else if (link) {
					link.removeAttribute("href");
				}

				// Hover Card Logic
				var hoverTitle = document.getElementById("hover-status-title");
				var hoverArt = document.getElementById("hover-art");
				var hoverTrackText = document.getElementById("hover-track");
				var hoverArtistText = document.getElementById("hover-artist");
				var hoverTime = document.getElementById("hover-time");

				if (hoverTitle && hoverArt && hoverTrackText && hoverArtistText && hoverTime) {
					hoverArt.src = image;
					hoverTrackText.textContent = trackData.name;
					hoverArtistText.textContent = (trackData.artist && trackData.artist["#text"]) || "Unknown Info";

					var dateStr = "Unknown time";
					if (isPlaying) {
						hoverTitle.textContent = "NOW PLAYING";
						dateStr = new Date().toLocaleString("en-US");
					} else {
						hoverTitle.textContent = "NOT PLAYING";
						if (trackData.date && trackData.date.uts) {
							var d = new Date(parseInt(trackData.date.uts) * 1000);
							dateStr = d.toLocaleString("en-US");
						}
					}
					hoverTime.textContent = "Last listened " + dateStr;
				}

				var toggleHistoryBtn = document.getElementById("open-history-btn");
				var historyDropdown = document.getElementById("history-dropdown");
				if (toggleHistoryBtn && historyDropdown) {
					var newBtn = toggleHistoryBtn.cloneNode(true);
					toggleHistoryBtn.parentNode && toggleHistoryBtn.parentNode.replaceChild(newBtn, toggleHistoryBtn);

					newBtn.addEventListener("click", function(e) {
						e.preventDefault();
						e.stopPropagation();
						historyDropdown.classList.toggle("hidden");
						historyDropdown.classList.toggle("flex");
						if (historyDropdown.classList.contains("flex")) {
							newBtn.textContent = "HIDE LISTENING HISTORY";
						} else {
							newBtn.textContent = "CLICK TO OPEN LISTENING HISTORY";
						}
					});
				}

				if (statusDot && statusText) {
					if (isPlaying) {
						statusDot.className = "h-1.5 w-1.5 rounded-full bg-green-500 animate-pulse";
						statusText.textContent = "PLAYING";
						statusText.className = "text-[10px] font-bold tracking-widest text-green-500 uppercase font-mono";
					} else {
						statusDot.className = "h-1.5 w-1.5 rounded-full bg-amber-500";
						statusText.textContent = "PAUSED";
						statusText.className = "text-[10px] font-bold tracking-widest text-amber-500 uppercase font-mono";
					}
				}

				// Populate recently played list using safe DOM APIs (no innerHTML)
				var recentList = document.getElementById("lastfm-recent-list");
				if (recentList && tracks.length > 1) {
					recentList.replaceChildren();
					var historyTracks = tracks.slice(1, 6);
					for (var i = 0; i < historyTracks.length; i++) {
						recentList.appendChild(buildHistoryItem(historyTracks[i]));
					}
				}
			} else if (skeleton) {
				skeleton.classList.add("hidden");
			}
		} catch (e) {
			var skeleton = document.getElementById("lastfm-skeleton");
			if (skeleton) skeleton.classList.add("hidden");
		}
	}

	fetchLastFm();

	setInterval(fetchLastFm, 30000);
</script>
