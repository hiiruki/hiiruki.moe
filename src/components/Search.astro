---
// Heavy inspiration taken from Astro Starlight -> https://github.com/withastro/starlight/blob/main/packages/starlight/components/Search.astro

import "@/styles/blocks/search.css";
---

<site-search class="ms-auto" id="search">
	<button
		class="hover:text-accent flex h-9 w-9 cursor-pointer items-center justify-center rounded-md"
		aria-keyshortcuts="Control+K Meta+K"
		data-open-modal
		disabled
	>
		<svg
			aria-hidden="true"
			class="h-7 w-7"
			fill="none"
			height="16"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="1.5"
			viewBox="0 0 24 24"
			width="16"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M0 0h24v24H0z" stroke="none"></path>
			<path d="M3 10a7 7 0 1 0 14 0 7 7 0 1 0-14 0M21 21l-6-6"></path>
		</svg>
		<span class="sr-only">Open Search</span>
	</button>
	<dialog
		aria-label="search"
		class="bg-global-bg h-full max-h-full w-full max-w-full border border-zinc-400 shadow-sm backdrop:backdrop-blur-sm open:flex sm:mx-auto sm:mt-16 sm:mb-auto sm:h-max sm:max-h-[calc(100%-8rem)] sm:min-h-[15rem] sm:w-5/6 sm:max-w-[48rem] sm:rounded-md"
	>
		<div class="dialog-frame flex grow flex-col gap-4 p-6 pt-12 sm:pt-6">
			<button
				class="ms-auto cursor-pointer rounded-md bg-zinc-200 p-2 font-semibold dark:bg-zinc-700"
				data-close-modal>Close</button
			>
			{
				import.meta.env.DEV ? (
					<div class="mx-auto text-center">
						<p>
							Search is only available in production builds. <br />
							Try building and previewing the site to test it out locally.
						</p>
					</div>
				) : (
					<div class="search-container">
						<div id="cactus__search" />
					</div>
				)
			}
		</div>
	</dialog>
</site-search>

<script is:inline type="module">
	class SiteSearch extends HTMLElement {
		constructor() {
			super();
			this.closeBtn = this.querySelector("button[data-close-modal]");
			this.dialog = this.querySelector("dialog");
			this.dialogFrame = this.querySelector(".dialog-frame");
			this.openBtn = this.querySelector("button[data-open-modal]");
			this.controller = new AbortController();

			if (this.openBtn) {
				this.openBtn.addEventListener("click", this.openModal.bind(this));
				this.openBtn.disabled = false;
			}

			if (this.closeBtn) {
				this.closeBtn.addEventListener("click", this.closeModal.bind(this));
			}

			if (this.dialog) {
				this.dialog.addEventListener("close", () => {
					window.removeEventListener("click", this.onWindowClickBound);
				});
			}

			var searchRoot = this.querySelector("#cactus__search");
			if (!searchRoot) return;

			var onIdle = window.requestIdleCallback || function(cb) { return setTimeout(cb, 1); };
			onIdle(async () => {
				try {
					var base = document.querySelector('base')?.getAttribute('href') || import.meta.env?.BASE_URL || "/";
					var cleanBase = base.replace(/\/$/, "");
					await import(cleanBase + "/pagefind/pagefind-ui.js");
					new window.PagefindUI({
						baseUrl: base,
						bundlePath: cleanBase + "/pagefind/",
						element: "#cactus__search",
						showImages: false,
						showSubResults: true,
					});
				} catch (error) {
					// Search stays unavailable if Pagefind assets are absent.
				}
			});
		}

		connectedCallback() {
			this.onWindowKeydownBound = this.onWindowKeydown.bind(this);
			this.onWindowClickBound = this.onWindowClick.bind(this);
			window.addEventListener("keydown", this.onWindowKeydownBound, { signal: this.controller.signal });
		}

		disconnectedCallback() {
			this.controller.abort();
		}

		openModal(event) {
			if (!this.dialog) return;
			this.dialog.showModal();
			this.querySelector("input")?.focus();
			if (event) event.stopPropagation();
			window.addEventListener("click", this.onWindowClickBound, { signal: this.controller.signal });
		}

		closeModal() {
			if (this.dialog) this.dialog.close();
		}

		onWindowClick(event) {
			var target = event.target;
			var isLink = target && "href" in target;
			if (isLink || (document.body.contains(target) && this.dialogFrame && !this.dialogFrame.contains(target))) {
				this.closeModal();
			}
		}

		onWindowKeydown(e) {
			if (!this.dialog) return;
			if ((e.metaKey === true || e.ctrlKey === true) && e.key === "k") {
				this.dialog.open ? this.closeModal() : this.openModal();
				e.preventDefault();
			}
		}
	}

	customElements.define("site-search", SiteSearch);
</script>
