---
import type { CollectionEntry } from "astro:content";

interface Props {
	newer?: CollectionEntry<"post">;
	older?: CollectionEntry<"post">;
}

const { newer, older } = Astro.props;
---

{
	(newer || older) && (
		<nav
			aria-label="Post navigation"
			class="mt-12 grid grid-cols-1 gap-4 border-t border-gray-200 pt-8 sm:grid-cols-2 dark:border-gray-800"
		>
			{older ? (
				<a
					href={`/posts/${older.id}/`}
					class="group flex flex-col gap-1 rounded-lg border border-gray-200 p-4 transition-colors hover:border-link dark:border-gray-800"
				>
					<span class="text-xs font-medium text-gray-500 dark:text-gray-400">
						← Older post
					</span>
					<span class="font-semibold text-accent-2 group-hover:text-link line-clamp-2">
						{older.data.title}
					</span>
				</a>
			) : (
				<span />
			)}
			{newer ? (
				<a
					href={`/posts/${newer.id}/`}
					class="group flex flex-col gap-1 rounded-lg border border-gray-200 p-4 text-end transition-colors hover:border-link dark:border-gray-800"
				>
					<span class="text-xs font-medium text-gray-500 dark:text-gray-400">
						Newer post →
					</span>
					<span class="font-semibold text-accent-2 group-hover:text-link line-clamp-2">
						{newer.data.title}
					</span>
				</a>
			) : (
				<span />
			)}
		</nav>
	)
}
